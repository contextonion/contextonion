  .code-example__copy svg {
    width: 1.45rem;
    height: 1.45rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  .code-example__copy:hover {
    background: rgb(255 255 255 / 8%);
    color: #fff;
  }

  .code-example__copy:focus-visible {
    outline: 2px solid #f2b8ff;
    outline-offset: 2px;
  }

  .code-example pre {
    max-height: 28rem;
    margin: 0;
    padding: 1.5rem 4.25rem 1.5rem 1.65rem;
    overflow: auto;
    color: #e2e2e8;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
    font-size: clamp(0.76rem, 1.9vw, 0.86rem);
    line-height: 1.6;
    tab-size: 2;
  }

  .code-example code {
    font: inherit;
  }

