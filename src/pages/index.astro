---
const title = 'Context Onion';
const description = 'Peel back the layers. Keep the context that matters.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.site} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <div class="mark" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <p class="eyebrow">Context Onion</p>
      <h1>Peel back the layers.</h1>
      <p class="lede">Keep the context that matters.</p>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    background: #0d0a12;
    color: #f8f3ff;
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-height: 100vh;
    margin: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 50% 40%, rgb(118 58 155 / 24%), transparent 30rem),
      #0d0a12;
  }

  main {
    width: min(44rem, calc(100% - 3rem));
    text-align: center;
  }

  .mark {
    position: relative;
    width: 7rem;
    height: 7rem;
    margin: 0 auto 2rem;
  }

  .mark span {
    position: absolute;
    inset: 0;
    margin: auto;
    border: 2px solid #c58af9;
    border-radius: 55% 45% 52% 48%;
    transform: rotate(45deg);
  }

  .mark span:nth-child(2) {
    inset: 1rem;
    border-color: #f2b8ff;
  }

  .mark span:nth-child(3) {
    inset: 2rem;
    border-color: #fff;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #c58af9;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.8rem, 10vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .lede {
    margin: 1.5rem 0 0;
    color: #c9c0d1;
    font-size: clamp(1.1rem, 3vw, 1.45rem);
  }
</style>
