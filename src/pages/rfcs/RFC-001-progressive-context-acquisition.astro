---
import { Content } from '../../../rfcs/RFC-001-progressive-context-acquisition.md';

const title = 'RFC-001: Progressive Context Acquisition for Engineering Agents';
const description = 'The Context Onion model for progressive context acquisition by engineering agents.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL('/rfcs/RFC-001-progressive-context-acquisition/', Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <nav aria-label="Breadcrumb">
        <a href="/">← Context Onion</a>
      </nav>
      <aside class="feedback" aria-label="RFC feedback">
        Have feedback on RFC-001?{' '}
        <a href="mailto:hello@contextonion.dev?subject=RFC-001%20feedback">
          Email hello@contextonion.dev
        </a>{' '}
        or open an issue or pull request in the{' '}
        <a href="https://github.com/contextonion/contextonion">canonical repository</a>.
      </aside>
      <article>
        <Content />
      </article>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    background: #0d0a12;
    color: #eee8f4;
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-height: 100vh;
    margin: 0;
    background:
      radial-gradient(circle at 50% 0%, rgb(118 58 155 / 18%), transparent 30rem),
      #0d0a12;
  }

  main {
    width: min(48rem, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: 3rem 0 6rem;
  }

  nav {
    margin-bottom: 1.5rem;
  }

  a {
    color: #d39af9;
    text-underline-offset: 0.2em;
  }

  a:hover {
    color: #edcfff;
  }

  .feedback {
    margin: 0 0 3rem;
    padding: 0.9rem 1rem;
    border: 1px solid rgb(197 138 249 / 24%);
    border-radius: 0.75rem;
    background: rgb(197 138 249 / 7%);
    color: #bfb3c8;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  article {
    font-size: 1.04rem;
    line-height: 1.75;
  }

  article h1,
  article h2,
  article h3 {
    color: #fff;
    line-height: 1.15;
    text-wrap: balance;
  }

  article h1 {
    margin: 0 0 2.5rem;
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    letter-spacing: -0.055em;
  }

  article h2 {
    margin: 3.5rem 0 1rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgb(197 138 249 / 24%);
    font-size: clamp(1.55rem, 4vw, 2.1rem);
    letter-spacing: -0.025em;
  }

  article h3 {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.3rem;
  }

  article p,
  article li {
    color: #d1c8d9;
  }

  article strong {
    color: #fff;
  }

  article blockquote {
    margin: 2rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 3px solid #c58af9;
    font-size: 1.15rem;
  }

  article pre {
    max-width: 100%;
    overflow-x: auto;
    padding: 1.25rem;
    border: 1px solid rgb(197 138 249 / 24%);
    border-radius: 0.75rem;
    background: #17101f;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  article code:not(pre code) {
    padding: 0.12em 0.35em;
    border-radius: 0.3rem;
    background: rgb(197 138 249 / 12%);
    color: #f1dfff;
    font-size: 0.92em;
  }

  article li + li {
    margin-top: 0.35rem;
  }

  @media (max-width: 36rem) {
    main {
      padding-top: 2rem;
    }

    nav {
      margin-bottom: 1.25rem;
    }

    .feedback {
      margin-bottom: 2rem;
    }
  }
</style>
